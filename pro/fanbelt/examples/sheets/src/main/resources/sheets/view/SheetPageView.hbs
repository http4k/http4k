<!doctype html>
<html lang="en">
<head>
  <base href="{{shell.base}}">
  <meta charset="utf-8">
  <title>Fanbelt sheets</title>
  <script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.4/bundles/datastar.js"></script>
  <style>
    body { font-family: system-ui, sans-serif; margin: 1.5rem; }
    .here span { margin-right: .5rem; padding: .1rem .4rem; background: #eef; border-radius: .5rem; }
    table { border-collapse: collapse; }
    th { background: #f5f5f4; font-weight: normal; padding: .2rem .4rem; }
    td { border: 1px solid #ddd; padding: 0; position: relative; }
    td.mine { outline: 2px solid #36c; }
    td input { all: unset; display: block; width: 6rem; height: 1.4rem; padding: 0 .3rem; }
    td::after { position: absolute; top: -0.9rem; left: 0; font-size: .65rem; background: #c63; color: white; padding: 0 .2rem; white-space: nowrap; }
    .error { color: #c33; }
  </style>
</head>
<body data-viewer="{{viewer}}" data-init="{{shell.connect}}" data-signals="{{shell.signals}}">
  <p class="error" data-show="$errors.edit" data-text="$errors.edit"></p>
  {{{shell.regions.here}}}
  <table id="grid">
    <thead><tr><th></th>{{#each columns}}<th>{{this}}</th>{{/each}}</tr></thead>
    <tbody>{{#each rows}}{{{this}}}{{/each}}</tbody>
  </table>
  {{{shell.regions.cursors}}}
  <script>
    document.addEventListener('keydown', event => {
      const cell = /^cell-([A-J])(\d+)$/.exec(event.target.id || '')
      const tab = event.shiftKey ? [-1, 0] : [1, 0]
      const step = { ArrowUp: [0, -1], ArrowDown: [0, 1], ArrowLeft: [-1, 0], ArrowRight: [1, 0], Tab: tab }[event.key]
      if (!cell || !step) return
      let column = cell[1].charCodeAt(0) - 65 + step[0]
      let row = Number(cell[2]) + step[1]
      if (event.key === 'Tab' && (column < 0 || column > 9)) {
        row += column < 0 ? -1 : 1
        column = column < 0 ? 9 : 0
      }
      const next = document.getElementById('cell-' + String.fromCharCode(65 + column) + row)
      if (!next) return
      event.preventDefault()
      next.focus()
      next.click()
    })
  </script>
</body>
</html>
