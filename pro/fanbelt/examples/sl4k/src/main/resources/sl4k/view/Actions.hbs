{{#unless deleted}}<div class="actions">{{#each palette}}<button class="add-reaction" data-emoji="{{name}}" aria-label="React with {{name}}" data-on:click="@post('{{../path}}/react/{{name}}')">{{glyph}}</button>{{/each}}{{#if threadPath}}<a href="{{threadPath}}">Reply</a><button class="toggle-pin" data-on:click="@post('{{path}}/pin')">{{#if pinned}}Unpin{{else}}Pin{{/if}}</button>{{/if}}<span class="own"><button class="edit-message" data-on:click="@post('{{path}}/editing')">Edit</button><button class="delete-message" data-on:click="@post('{{path}}/delete')">Delete</button></span></div>{{/unless}}