<div id="bookmarks">{{#each bookmarks}}<span id="b-{{id}}" class="bookmark"><a href="{{url}}" target="_blank" rel="noopener noreferrer">{{title}}</a><button class="remove-bookmark" aria-label="Remove {{title}}" data-on:click="@post('c/{{../channel}}/bookmarks/{{id}}/remove')">&#10005;</button></span>{{/each}}<button class="add-bookmark" data-show="!$addingBookmark" data-on:click="$addingBookmark = true">+ Bookmark</button><form data-show="$addingBookmark" data-on:submit="@post('c/{{channel}}/bookmarks')"><input class="title" data-bind:title placeholder="Title" aria-label="Bookmark title"><input class="url" data-bind:url placeholder="https://…" aria-label="Bookmark link"><button>Add</button><button type="button" class="cancel-bookmark" data-on:click="$addingBookmark = false; $errors.addingBookmark = ''">Cancel</button>{{> sl4k/view/Error field="addingBookmark"}}</form></div>
