<div id="topic"><button class="edit-topic" data-show="!$editingTopic" data-on:click="@post('c/{{channel}}/topic/editing')">{{#if topic}}<span class="text">{{topic}}</span>{{else}}Add a topic{{/if}}</button><form data-show="$editingTopic" data-on:submit="@post('c/{{channel}}/topic')"><input data-bind:topic data-effect="$editingTopic && el.focus()" aria-label="Channel topic"><button type="button" class="cancel-topic" data-on:click="$editingTopic = false; $errors.topic = ''">Cancel</button>{{> sl4k/view/Error field="topic"}}</form></div>
