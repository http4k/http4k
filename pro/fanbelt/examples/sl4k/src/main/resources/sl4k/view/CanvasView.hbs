<section id="canvas" data-show="$_canvasOpen">{{#if text}}<pre class="body" data-show="!$editingCanvas">{{text}}</pre>{{else}}<p class="blank" data-show="!$editingCanvas">Nothing here yet.</p>{{/if}}<button class="edit-canvas" data-show="!$editingCanvas" data-on:click="@post('c/{{channel}}/canvas/editing')">Edit</button><form data-show="$editingCanvas" data-on:submit="@post('c/{{channel}}/canvas')"><textarea data-bind:canvas aria-label="Canvas"></textarea><button class="save-canvas">Save</button> <button type="button" class="cancel-canvas" data-on:click="$editingCanvas = false; $errors.canvas = ''">Cancel</button>{{> sl4k/view/Error field="canvas"}}</form></section>
