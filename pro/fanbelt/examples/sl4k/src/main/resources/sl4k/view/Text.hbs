{{#if deleted}}<p class="text deleted">This message was deleted</p>{{else}}<div class="text">{{#each parts}}{{#if who}}<span class="mention {{classes}}" data-mention="{{who.id}}" data-name="{{who.name}}">{{text}}</span>{{else if link}}<a class="{{classes}}" href="{{link}}" target="_blank" rel="noopener noreferrer">{{text}}</a>{{else if code}}<code>{{text}}</code>{{else if block}}<pre>{{text}}</pre>{{else if classes}}<span class="{{classes}}">{{text}}</span>{{else}}{{text}}{{/if}}{{/each}}</div>{{#if edited}}<span class="edited">(edited)</span>{{/if}}{{/if}}