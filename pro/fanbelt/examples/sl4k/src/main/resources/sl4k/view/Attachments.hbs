{{#if attachments}}<div class="attachments">{{#each attachments}}<span class="file"><a class="attachment" data-name="{{name}}" href="{{path}}" target="_blank" rel="noopener">{{#if inline}}<img src="{{path}}" alt="{{name}}" loading="lazy">{{else}}&#128196; {{name}}{{/if}}</a><a class="download" href="{{path}}" download="{{name}}" aria-label="Download {{name}}" title="Download">&#8595;</a></span>{{/each}}</div>{{/if}}
